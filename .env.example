# ============================================================
# 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后编辑 .env，把下面的占位符换成真实值
#
# ⚠️ .env 已被 .gitignore 忽略，不会提交到 git
# ============================================================

# DeepSeek API Key（用于生成答案）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 阿里百炼 API Key（qwen-vl 空表体二次提取用）
# 申请地址：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 阿里百炼 qwen-vl 兼容模式端点（MinerU 空表体二次提取用）
DASHSCOPE_VL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ============================================================
# PDF 加载器配置
# ============================================================

# 加载器选择（推荐使用 auto）
# - auto：自动检测 PDF 质量，智能选择最佳加载器（默认）
#   * 有字体层级 → pypdf（快速本地解析）
#   * 字体缺失/扫描件 → mineru（在线 OCR，产生费用）
# - pypdf：强制本地解析（快速，但对扫描件无效）
# - mineru：强制在线解析（慢但质量高，需配置 API Key）
PDF_LOADER=auto

# 表格行级序列化开关（默认 0 关闭）
# - 1：开启，MinerU 表格转「配置项 | 列名: 值」自解释文本（符号 ●/○/- 替换为 标配/选装/不含），
#       chunk 输出到 chunks_rowwise/
# - 0：关闭，保留原始 HTML 表体，chunk 输出到 chunks/
# 用途：两套方案各自入库，做检索效果对比
TABLE_ROW_SERIALIZATION=0

# ============================================================
# 检索配置（向量化 + 入库，切组合后建库和检索自动一致）
# ============================================================

# 向量化模型（bge-m3 | dashscope）
# - bge-m3：本地模型（约 2.2GB，首次自动下载，无网络依赖）
# - dashscope：阿里百炼 API（换模型只改 DASHSCOPE_EMBED_MODEL 字符串）
EMBED_MODEL=bge-m3

# DashScope 向量化配置（仅 EMBED_MODEL=dashscope 时生效，复用 DASHSCOPE_API_KEY）
DASHSCOPE_EMBED_MODEL=text-embedding-v4
DASHSCOPE_EMBED_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# 可选：自定义向量维度（仅 v4 支持；改维度后必须重建索引）
# DASHSCOPE_EMBED_DIM=1024

# 向量库（chroma | faiss）
# - chroma：默认，自带持久化，余弦相似度
# - faiss：预留工程位，未实现
VECTOR_STORE=chroma

# chunk 输入目录（相对项目根；检索对比时切 chunks / chunks_rowwise）
CHUNKS_DIR=processed_docs/mineru/chunks

# MinerU API Key（仅当 PDF_LOADER=auto 或 mineru 时需要）
# 申请地址：https://mineru.net
# 注意：MinerU 是付费 API，auto 模式下只对字体信息缺失的 PDF 才会调用
MINERU_API_KEY=your-mineru-key-here
