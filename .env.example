# ============================================================
# 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后编辑 .env，把下面的占位符换成真实值
#
# .env 已被 .gitignore 忽略，不会提交到 git
# ============================================================

# DeepSeek API Key（答案生成、对比题改写）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 阿里百炼 API Key（qwen-vl 配置表重转录、dashscope 向量化/重排）
# 申请地址：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 阿里百炼 qwen-vl 兼容模式端点（配置表表格重转录）
DASHSCOPE_VL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ============================================================
# PDF 加载器配置
# ============================================================

# 加载器选择（推荐 auto）
# - auto：按书签层级分流（默认）
#   * 书签层级 >= 2 → pypdf（本地切分，如 BMW 手册）
#   * 其他 → mineru（扁平书签手册、配置表、扫描件）
# - pypdf：强制本地解析
# - mineru：强制在线解析（需 MINERU_API_KEY）
PDF_LOADER=auto

# 表格行级序列化（默认 0）
# - 1：每行独立 chunk，输出到 chunks_rowwise/（当前检索方案）
# - 0：整表 HTML，输出到 chunks/
TABLE_ROW_SERIALIZATION=1

# MinerU API Key（PDF_LOADER=auto 或 mineru 时需要）
# 申请地址：https://mineru.net
MINERU_API_KEY=your-mineru-key-here

# ============================================================
# 检索配置（切组合后建库和检索自动一致）
# ============================================================

# 向量化模型（bge-m3 | dashscope）
# - bge-m3：本地模型（约 2.2GB，首次自动下载）
# - dashscope：阿里百炼 API（复用 DASHSCOPE_API_KEY）
EMBED_MODEL=bge-m3

# DashScope 向量化（仅 EMBED_MODEL=dashscope 时生效）
DASHSCOPE_EMBED_MODEL=text-embedding-v4
DASHSCOPE_EMBED_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# 可选：自定义向量维度（仅 v4 支持；改维度后必须重建索引）
# DASHSCOPE_EMBED_DIM=1024

# 向量库（chroma | elasticsearch | faiss）
# - chroma：默认，自带持久化，余弦相似度
# - elasticsearch：外部 ES，dense_vector + HNSW
# - faiss：预留，未实现
VECTOR_STORE=chroma

# Elasticsearch（仅 VECTOR_STORE=elasticsearch 时生效）
# 索引名自动包含向量模型和 chunk 变体，不同实验互不覆盖
ES_URL=http://localhost:9200
# ES_API_KEY=your-es-api-key
# ES_USERNAME=elastic
# ES_PASSWORD=your-es-password

# chunk 输入目录（相对项目根；支持 glob）
# 行级方案：processed_docs/*/chunks_rowwise
# 整表对照：processed_docs/*/chunks
CHUNKS_DIR=processed_docs/*/chunks_rowwise

# 重排器（bge | dashscope | none）
# - bge：本地 bge-reranker-v2-m3（默认）
# - dashscope：百炼 gte-rerank-v2（复用 DASHSCOPE_API_KEY）
# - none：不重排（对照组）
RERANK_MODEL=bge
